{
  "manifest_version": 3,
  "name": "Script Manager (prueba)",
  "version": "0.14.0",
  "version_name": "0.14.0 - patrones tolerantes, importación activa y versiones sin ruido",
  "description": "Base de prueba: carga y gestiona múltiples scripts por página.",
  "minimum_chrome_version": "135",
  "permissions": [
    "storage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Script Manager",
    "default_popup": "pages/popup.html"
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  }
}
